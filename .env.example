# Copy this file to .env and edit. NEVER commit .env (it is in .gitignore).
# Every name below is read by the code in examples/ or capstone/knowledge_assistant/config.py.

# --- Provider credentials (only needed for live model calls) ---
OPENAI_API_KEY=your-api-key-here

# --- Model names are configuration, not code ---
# Pick models available to YOUR account from the provider's current documentation.
LLM_MODEL=your-chat-model-name
EMBEDDING_MODEL=your-embedding-model-name

# --- Capstone settings ---
# hashing (offline, teaching/testing only) | openai | sentence-transformers (optional install)
EMBEDDER_BACKEND=hashing
KB_DATA_DIR=sample_data/docs
KB_INDEX_PATH=.kb_index.json
KB_NOTES_DIR=notes
MIN_SIMILARITY=0.12
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=30

# Comma-separated key:user:role entries. Roles: public, student, staff.
# Replace these demo values with long random strings (for example: python -c "import secrets; print(secrets.token_urlsafe(32))")
KB_API_KEYS=replace-me-1:alice:student,replace-me-2:sam:staff
